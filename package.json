{
  "name": "leadpilot-ai-crm-monorepo",
  "version": "3.1.0",
  "private": true,
  "description": "LeadPilot AI CRM Enterprise Monorepo Workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "scripts": {
    "build": "npm run build --prefix apps/web",
    "dev:api": "npm run start --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "test:api": "npm test --prefix apps/api",
    "lint:web": "npm run lint --prefix apps/web"
  }
}
